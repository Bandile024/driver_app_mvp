# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-a-different-random-secret
HOST=127.0.0.1
PORT=4040
DB_PATH=./data/dispatch.sqlite
# Comma-separated web preview origins. Native Android does not need CORS.
CORS_ORIGINS=http://localhost:8081
# Optional Expo push access token if push security is enabled
# EXPO_ACCESS_TOKEN=
